# Owner role: runs migrations and seed. Never used by the running app.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ngb
# Restricted role the API and worker use. Row-level security applies to it.
APP_DATABASE_URL=postgres://ngb_app:ngb_app@localhost:5432/ngb
JWT_SECRET=change-me-in-every-environment
PORT=3000
# Where uploaded files go in development. Production uses S3.
FILE_STORAGE_DIR=./storage
# Messages are logged, not sent, until a WhatsApp provider is chosen.
# Set to true to make every WhatsApp send fail, to watch retries and failure handling.
SIMULATE_WHATSAPP_OUTAGE=false
